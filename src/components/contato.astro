---
import Container from "@components/container.astro";
import { Icon } from "astro-icon/components";
import { SITE_CONFIG } from "@/config";
---

<div id="contato" class="w-full py-20 md:py-24 bg-rizoma-green-lighter" style="position: relative; z-index: 10;">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl md:text-4xl font-bold leading-tight text-white">
        Saiba como podemos te ajudar
      </h2>

      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="https://forms.gle/XUzFRyVnbwB8AqQ39"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-white px-7 py-3.5 text-lg font-semibold text-rizoma-green shadow-md transition hover:bg-rizoma-bege sm:w-auto">
          Comece aqui
        </a>
      </div>

      <div class="mt-12 border-t border-white/20 pt-8">
        <div class="flex flex-col items-center justify-center gap-3 text-white/90 sm:flex-row sm:gap-8">
          <a
            href={`mailto:${SITE_CONFIG.EMAIL}`}
            class="inline-flex items-center gap-2 transition hover:text-white">
            <Icon class="h-4 w-4 text-white/60" name="uil:envelope" />
            {SITE_CONFIG.EMAIL}
          </a>
          <a
            href={`tel:+${SITE_CONFIG.WHATSAPP_PHONE}`}
            class="inline-flex items-center gap-2 transition hover:text-white">
            <Icon class="h-4 w-4 text-white/60" name="uil:phone" />
            (19) 99639-5866
          </a>
        </div>
      </div>
    </div>
  </Container>
</div>
