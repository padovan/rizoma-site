---
// @ts-ignore
import { Icon } from "astro-icon/components";
import Container from "@components/container.astro";
import rizomaLogo from "assets/rizoma-logo-transparent.png";

const etapas = [
  {
    title: "Critério técnico rigoroso",
    description:
      "Os profissionais indicados passam por avaliação criteriosa de Psicólogos(as) em com formação e percursos distintos. Selecionamos os profissionais que também seguem critérios rigorosos e técnicos quanto à formação, experiência clínica e alinhamento ético.",
    icon: "bx:bxs-heart",
  },
  {
    title: "Curadoria especializada",
    description:
      "Não trabalhamos com indicações genéricas ou listas amplas. Atuamos por curadoria clínica, priorizando qualidade sobre quantidade.",
    icon: "bx:bxs-brain",
  },
  {
    title: "Personalização real",
    description:
      "O encaminhamento não é automático. É pensado caso a caso pela equipe.",
    icon: "bx:bxs-happy-alt",
  },
  {
    title: "Responsabilidade ética",
    description:
      "Seguimos as diretrizes dos Conselhos profissionais e respeitamos integralmente o sigilo e a confidencialidade.",
    icon: "bx:bxs-hand",
  },
];
---

<div id="especialidades" class="w-full py-20 relative overflow-hidden" style="background-color: #ffffff; position: relative; z-index: 10;">
  <!-- Background logo - only right half visible -->
  <div
    class="absolute left-0 top-0 h-full w-1/2 bg-no-repeat bg-contain opacity-15 pointer-events-none bg-logo"
    style={`background-image: url(${rizomaLogo.src}); background-position: right top; background-size: 200% auto;`}
  ></div>

  <style>
    @media (min-width: 768px) {
      #especialidades .bg-logo {
        background-position: right center !important;
      }
    }
  </style>

  <!-- Fade overlay only on the logo, not affecting text -->
  <div class="absolute left-0 top-0 h-full w-1/4 bg-gradient-to-r from-white/30 to-transparent pointer-events-none"></div>

<Container>
<div class="mb-16">
<div>
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Nossa Diferencial
  </h2>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-2 mt-16 gap-16">
  {
    etapas.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-rizoma-green rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white bg-rizoma-green" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-900 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
</div>
</Container>
</div>
