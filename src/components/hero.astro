---
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";
import { whatsappHelpers } from "@/config";

const whatsappUrl = whatsappHelpers.getWhatsappUrl(
  "Olá. Gostaria de mais informações sobre os serviços do Instituto Rizoma."
);
---

<div class="w-full bg-gradient-to-b from-white to-rizoma-bege relative z-10">
<Container>
  <main class="grid gap-12 py-16 md:py-24 lg:grid-cols-[1.15fr_1fr]">

    <div>
      <h1 class="text-4xl md:text-5xl lg:text-[3.4rem] font-bold leading-[1.1] text-rizoma-green">
        O vínculo certo começa com o profissional certo.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
        O Instituto Rizoma conecta você ao profissional de saúde mental certo — com
        <strong class="font-semibold text-rizoma-green">curadoria clínica</strong>, não algoritmo
        genérico.
      </p>

      <div class="mt-9">
        <Link
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-rizoma-green-button hover:bg-green-500 inline-flex gap-2 items-center px-6 py-3 rounded-full text-white font-semibold transition-colors text-lg">
          Entre em contato
        </Link>
      </div>

      <p class="mt-5 text-sm text-slate-500">
        Falar com a nossa equipe é gratuito. As sessões são pagas direto ao profissional.
      </p>
    </div>

    <!-- The promise, not the funnel: why the curation exists at all, which is
         what a visitor arriving from an ad is actually weighing. -->
    <aside class="lg:pt-10">
      <div class="rounded-lg border border-rizoma-bege-stronger bg-white p-7 shadow-lg">
        <h2 class="text-2xl leading-snug text-rizoma-green font-bold">
          A curadoria existe para que você comece a sua jornada terapêutica com segurança.
        </h2>
        <div class="mt-6 h-px w-full bg-rizoma-bege-stronger"></div>
        <p class="mt-5 leading-relaxed text-slate-600">
          Selecionamos psicólogos(as) que respondem a critérios rigorosos quanto à formação,
          experiência clínica e alinhamento ético.
        </p>
      </div>
    </aside>

  </main>
</Container>
</div>
