---
import { Picture } from "astro:assets";
import heroImage from "assets/rizoma-logo-transparent.png";
import waterImage from "assets/water.webp";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
import Container from "@components/container.astro";
import { whatsappHelpers } from "@/config";
---

<!-- Water background image - full width extending below -->
<div
  class="fixed inset-0 bg-cover bg-center bg-no-repeat opacity-80 pointer-events-none"
  style={`background-image: url(${waterImage.src}); height: 100vh; top: 0;`}
></div>

<!-- Content overlay - full width extending below -->
<div class="fixed inset-0 bg-white/20 pointer-events-none" style="height: 100vh; top: 0;"></div>

<Container>
<main
  class="grid lg:grid-cols-2 place-items-center min-h-screen pt-0 pb-16 md:pt-0 md:pb-20 relative z-10 items-center">

  <div class="py-6 md:order-1 order-2 relative z-10 flex flex-col justify-center">
    <Picture
      src={heroImage}
      alt="Instituto Rizoma de Saúde Integral - Logotipo representando cuidado multidisciplinar em saúde mental"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
      class="hidden md:block"
    />
    <div class="flex justify-center mt-4">
      <Link
        href={whatsappHelpers.getDefaultWhatsappUrl()}
        target="_blank"
        class="bg-rizoma-green-button hover:bg-green-500 inline-flex gap-1 items-center px-4 py-2 rounded-full text-white font-semibold transition-colors"
        rel="noopener noreferrer">
        <Icon class="text-white w-5 h-5" name="bx:bxl-whatsapp" />
        Fale com a gente
      </Link>
    </div>
  </div>
  <div class="relative flex flex-col justify-center">
    <div class="relative z-10">
      <h1
        class="text-3xl lg:text-4xl xl:text-5xl font-bold lg:tracking-tight xl:tracking-tighter">
        Encontrar um bom profissional é o primeiro passo para cuidar de você
      </h1>
      <div class="flex  justify-center mt-4 inline-block bg-white text-rizoma-green border border-rizoma-green px-4 py-2 rounded-lg font-semibold text-sm">
        ATENDIMENTO ONLINE E PRESENCIAL
      </div>
      <div class="bg-white/50 backdrop-blur-sm rounded-lg p-6 mt-4">
        <p class="text-lg md:text-2xl text-slate-900 max-w-xl">
          Nosso trabalho é realizado com a critério técnico, responsabilidade ética e sensibilidade clínica.
          Selecionamos <strong>psicólogos(as)</strong> e <strong>psiquiatras</strong> qualificados e analisamos cada caso com atenção,
          para indicar o profissional mais adequado às necessidades específicas de cada pessoa.
          </p>
        </div>
        <p class="text-lg md:text-2xl mt-4 text-slate-900 max-w-xl" style="display: none;">
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
      </div>
    </div>
  </div>
</main>
</Container>
