---
// @ts-ignore
import { Icon } from "astro-icon/components";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import rizomaLogo from "assets/rizoma-logo-transparent.png";

const etapas = [
  {
    title: "Critério técnico rigoroso",
    description:
      "Os profissionais indicados passam por avaliação criteriosa de Psicólogos(as) em com formação e percursos distintos. Selecionamos os profissionais que também seguem critérios rigorosos e técnicos quanto à formação, experiência clínica e alinhamento ético.",
    icon: "bx:bxs-heart",
  },
  {
    title: "Curadoria especializada",
    description:
      "Não trabalhamos com indicações genéricas ou listas amplas. Atuamos por curadoria clínica, priorizando qualidade sobre quantidade.",
    icon: "bx:bxs-brain",
  },
  {
    title: "Personalização real",
    description:
      "O encaminhamento não é automático. É pensado caso a caso pela equipe.",
    icon: "bx:bxs-happy-alt",
  },
  {
    title: "Responsabilidade ética",
    description:
      "Seguimos as diretrizes dos Conselhos profissionais e respeitamos integralmente o sigilo e a confidencialidade.",
    icon: "bx:bxs-hand",
  },
];
---

<div id="diferencial" class="w-full py-20 md:py-28 bg-white relative overflow-hidden" style="position: relative; z-index: 10;">
  <!-- Background logo - only right half visible -->
  <div
    class="absolute left-0 top-0 h-full w-1/2 bg-no-repeat bg-contain opacity-[0.07] pointer-events-none bg-logo"
    style={`background-image: url(${rizomaLogo.src}); background-position: right top; background-size: 200% auto;`}
  ></div>

  <style>
    @media (min-width: 768px) {
      #diferencial .bg-logo {
        background-position: right center !important;
      }
    }
  </style>

  <Container>
    <Sectionhead top={false}>
      <Fragment slot="title">Nosso diferencial</Fragment>
      <Fragment slot="desc">O que sustenta cada indicação que fazemos.</Fragment>
    </Sectionhead>

    <div class="relative grid sm:grid-cols-2 mt-14 gap-6 max-w-5xl mx-auto">
      {
        etapas.map((item) => (
          <div class="flex gap-5 items-start rounded-2xl bg-white/80 backdrop-blur-sm p-7 ring-1 ring-rizoma-green/10 shadow-sm transition hover:shadow-md hover:-translate-y-0.5">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-rizoma-green">
              <Icon class="h-5 w-5 text-white" name={item.icon} />
            </div>
            <div>
              <h3 class="font-bold text-lg text-rizoma-green">{item.title}</h3>
              <p class="text-slate-600 mt-2 leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</div>
