---
import { Picture } from "astro:assets";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import AnaCarolinaImg from "assets/ana-carolina.png";
import JoaoImg from "assets/joao.png";
import LaraImg from "assets/lara.png";

const teamMembers = [
  {
    id: "ana-carolina",
    name: "Ana Carolina Simão",
    title: "Psicóloga",
    credentials: "(CRP 06/118379)",
    image: AnaCarolinaImg,
    alt: "Ana Carolina Simão - Psicóloga especializada em psicanálise contemporânea e saúde mental",
    profileUrl: "/profissionais/ana-carolina",
    details: [
      "Formada em Psicologia com ênfase em Clínica pela PUC-Campinas, **Mestre em Ciências - Saúde Mental pela Unicamp**, possui 9 anos de experiência na clínica privada e no **trabalho com grupos** em instituições.",
      "Seu percurso também passa pelo aprimoramento em saúde mental (Instituto A Casa) com casos mais graves, cursos sobre psicanálise de grupo (Instituto Gerar de Psicanálise) e aperfeiçoamento em **psicanálise contemporânea.**",
      "Trabalha em consultório particular com questões que atravessam nosso tempo e nossa cultura, atingindo principalmente **adolescentes e adultos com ansiedade, transição de carreira, síndrome do imigrante e estresse pós-traumático.**"
    ]
  },
  {
    id: "joao",
    name: "João Paulo Zerbinati",
    title: "Psicólogo",
    credentials: "(CRP 06/119389)",
    image: JoaoImg,
    alt: "Dr. João Paulo Zerbinati - Psicólogo com doutorado em Psicologia pela USP",
    details: [
      "Psicólogo com mais de 10 anos de experiência clínica. Graduado pela PUC-Campinas com ênfase em clínica psicanalítica, **mestre pela UNESP e doutor em Psicologia pela USP**.",
      "Atua com ênfase no desenvolvimento emocional e na saúde mental pela perspectiva da **psicanálise contemporânea** (Freud e Winnicott). Mantém estudos avançados em sociedades psicanalíticas ligadas à Associação Psicanalítica Internacional.",
      "Sua trajetória combina prática clínica com produção científica nas áreas de **Psicanálise, Psicologia, Gênero e Sexualidade**."
    ]
  },
  {
    id: "lara",
    name: "Lara Sousa Blanes",
    title: "Psicóloga",
    credentials: "(CRP 06/120257)",
    image: LaraImg,
    alt: "Lara Sousa Blanes - Psicóloga existencial fenomenológica especialista em redução de danos",
    details: [
      "Psicóloga existencial-fenomenológica, sanitarista e redutora de danos, formada pela PUC-Campinas, com participação em grupos de estudos na UNICAMP e **mais de 10 anos de experiência em saúde mental, políticas públicas e cuidado em contextos relacionados ao uso de substâncias psicoativas**. Atuou por oito anos em CAPS AD, além de participar da implementação de serviços e do fortalecimento da Rede de Atenção Psicossocial (RAPS).",
      "Na clínica, acompanha adultos a partir de uma **perspectiva existencial fenomenológica, interdisciplinar e centrada na singularidade**, com atuação em saúde mental, redução de danos e nas interfaces entre cuidado, cannabis e psicodélicos.",
      "É membro colaboradora da **Associação Psicodélica Brasileira (APB)**, cofundadora do **Coletivo Entre Caminhos**, voltado à interlocução entre psicologia, saberes tradicionais, psicodélicos e saúde, e cofundadora do **Coletivo Florescência**, iniciativa dedicada à construção de práticas interdisciplinares de cuidado em saúde mental e cannabis medicinal.",
      "Também atua com supervisão clínica e institucional, educação permanente e desenvolvimento de projetos em saúde."
    ]
  }
];

const bold = (text: string) => text.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
---

<div id="equipe" class="w-full py-20 md:py-28 bg-rizoma-bege" style="position: relative; z-index: 10;">
  <Container>
    <Sectionhead top={false}>
      <Fragment slot="title">Nossa equipe</Fragment>
      <Fragment slot="desc">Profissionais especializados e experientes trabalhando juntos pelo seu bem-estar.</Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-4xl mt-14">
      <!-- One card per professional. The card is the toggle: it opens the
           matching panel below the grid, so the grid never reflows and only
           one biography is open at a time. -->
      <div class="grid gap-6 sm:grid-cols-3">
        {teamMembers.map((member) => (
          <button
            type="button"
            class="team-member-trigger group flex w-full items-center gap-4 rounded-2xl bg-white p-4 text-left ring-1 ring-rizoma-green/10 shadow-sm transition hover:-translate-y-1 hover:shadow-lg sm:flex-col sm:items-stretch sm:gap-0 sm:p-3"
            data-member-id={member.id}
            aria-expanded="false"
            aria-controls={`detalhes-${member.id}`}>
            <div class="h-28 w-28 shrink-0 overflow-hidden rounded-xl sm:h-auto sm:w-full">
              <Picture
                src={member.image}
                alt={member.alt}
                sizes="(max-width: 640px) 112px, 280px"
                width={280}
                height={280}
                class="h-full w-full bg-white object-cover object-center aspect-square"
              />
            </div>
            <div class="sm:mt-4 sm:px-2 sm:pb-2">
              <h3 class="text-lg font-bold text-rizoma-green">{member.name}</h3>
              <p class="text-sm text-slate-600">{member.title} {member.credentials}</p>
              <span class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-rizoma-green-button">
                Ver perfil
                <svg class="h-4 w-4 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12h14M19 12l-6-6M19 12l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </button>
        ))}
      </div>

      {teamMembers.map((member) => (
        <div
          id={`detalhes-${member.id}`}
          class="team-member-details hidden mt-8 rounded-2xl border-l-4 border-rizoma-green bg-white p-6 shadow-lg md:p-8"
          data-member-id={member.id}>
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-2xl font-bold text-rizoma-green">
              {member.name} <span class="font-normal text-slate-500">— {member.title}</span>
            </h3>
            <button
              type="button"
              class="close-details shrink-0 rounded-full p-1 text-slate-400 transition hover:bg-rizoma-bege hover:text-rizoma-green"
              aria-label={`Fechar perfil de ${member.name}`}>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <div class="mt-4 space-y-4">
            {member.details.map((detail) => (
              <p class="leading-relaxed text-slate-700" set:html={bold(detail)} />
            ))}
          </div>
          {member.profileUrl && (
            <a
              href={member.profileUrl}
              class="mt-6 inline-flex items-center gap-1 font-semibold text-rizoma-green-button hover:underline">
              Ver página completa
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M19 12l-6-6M19 12l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </Container>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const triggers =
      document.querySelectorAll<HTMLElement>(".team-member-trigger");
    const panels = document.querySelectorAll<HTMLElement>(".team-member-details");

    const close = (panel: HTMLElement) => {
      panel.classList.add("hidden");
      document
        .querySelector(`.team-member-trigger[data-member-id="${panel.dataset.memberId}"]`)
        ?.setAttribute("aria-expanded", "false");
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const id = trigger.dataset.memberId;
        const panel = document.querySelector<HTMLElement>(
          `.team-member-details[data-member-id="${id}"]`
        );
        if (!panel) return;

        const willOpen = panel.classList.contains("hidden");
        panels.forEach(close);

        if (willOpen) {
          panel.classList.remove("hidden");
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.querySelectorAll(".close-details").forEach((button) => {
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        const panel = (button as HTMLElement).closest<HTMLElement>(
          ".team-member-details"
        );
        if (panel) close(panel);
      });
    });
  });
</script>
